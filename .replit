modules = ["python-3.10", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NasTech Sync"

[[workflows.workflow]]
name = "NasTech Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
